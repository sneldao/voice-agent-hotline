# Voice Agent Hotline - Environment Variables
# Copy this file to .env.local and fill in your values

# ===============================================
# Thirdweb Configuration (REQUIRED for x402 payments)
# Get your keys from: https://thirdweb.com/dashboard
# ===============================================
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your_thirdweb_client_id
THIRDWEB_SECRET_KEY=your_secret_key_for_x402

# ============================================
# Celo Network (Celo Sepolia Testnet)
# Chain ID: 11142220
# ===============================================
CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
NEXT_PUBLIC_CELO_CHAIN_ID=11142220

# Payment receiver wallet (where payments go)
# Get testnet cUSD from: https://faucet.celo.org/
PAYMENT_RECEIVER=0xYourWalletAddressHere

# ===============================================
# WalletConnect (REQUIRED for wallet connection)
# Get your Project ID from: https://cloud.walletconnect.com
# ============================================
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# ===============================================
# Upstash Redis (REQUIRED for production)
# Get credentials from: https://console.upstash.com
# ⚠️ WARNING: Missing credentials cause build warnings
# ============================================
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
UPSTASH_REDIS_URL=${UPSTASH_REDIS_REST_URL}
UPSTASH_REDIS_TOKEN=${UPSTASH_REDIS_REST_TOKEN}

# ===============================================
# x402 Payment Protocol (REQUIRED for micropayments)
# https://x402.org
# ===============================================
X402_FACILITATOR_URL=https://x402.facilitator.example.com
NEXT_PUBLIC_X402_ENABLED=true

# ===============================================
# Payment Settlement
# Users sign their own transactions - no facilitator needed
# ===============================================
NEXT_PUBLIC_PAYMENT_SETTLEMENT_ENABLED=true

# ===============================================
# Admin Access
# Comma-separated wallet addresses allowed to access /admin
# ===============================================
NEXT_PUBLIC_ADMIN_WALLETS=0xYourWalletAddressHere

# ===============================================
# Agent Notifications
# Webhook URL for agent approve/reject notifications
# ===============================================
AGENT_NOTIFICATION_WEBHOOK_URL=

# ===============================================
# OpenClaw Integration
# ===============================================
OPENCLAW_WEBHOOK_SECRET=

# ===============================================
# ElevenLabs Voice API (REQUIRED for real TTS)
# Get your API key from: https://elevenlabs.io/api
# ===========================================
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_DEFAULT_VOICE=Adam

# ===============================================
# VOISSS Integration (Voice over IP for AI Agents)
# https://voisss.netlify.app
# ===============================================
VOISSS_URL=https://voisss.netlify.app
AGENT_WALLET=0xYourAgentWalletAddress

# ===============================================
# ERC-8004 Agent Registry (Celo Sepolia - chain ID 11142220)
# Contracts deployed - users sign their own transactions
# ============================================
NEXT_PUBLIC_ERC8004_ENABLED=true
NEXT_PUBLIC_ERC8004_IDENTITY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
NEXT_PUBLIC_ERC8004_REPUTATION_ADDRESS=0x8004B663056A597Dffe9eCcC1965A193B7388713
NEXT_PUBLIC_ERC8004_DELEGATION_ADDRESS=0xb17A8dC3E37B9b95282cEA6594c1dFAa16026D00

# =============================================
# Feature Flags (SET TO FALSE FOR PRODUCTION)
# ============================================
# DEMO_MODE bypasses all delegation auth - SET TO FALSE FOR PRODUCTION
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_PAYMENTS_ENABLED=true
NEXT_PUBLIC_RECORDING_ENABLED=true

# ==============================================
# ElevenLabs Conversational AI (REQUIRED for voice agents)
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
# ==============================================
ELEVENLABS_CONVERSATIONAL_ENABLED=true

# ===============================================
# Composio Tool Integration (REQUIRED for agent tools)
# Get your API key from: https://composio.dev
# ==============================================
COMPOSIO_API_KEY=your_composio_api_key_here

# Webhook URL for tool callbacks (set to your production domain)
NEXT_PUBLIC_WEBHOOK_URL=https://your-app.vercel.app

# ===============================================
# ElevenLabs Webhook Authentication (REQUIRED in production)
# Set this to a random secret string and configure the same value in your
# ElevenLabs webhook settings as the X-ElevenLabs-Secret header.
# In production, webhooks are REJECTED when this is not set.
# ===============================================
ELEVENLABS_WEBHOOK_SECRET=your_webhook_secret_here

# ===============================================
# VOISSS ElevenLabs Conversational AI Agent IDs
# Run `npx tsx scripts/seed-elevenlabs.ts` to generate these.
# ===============================================
ELEVENLABS_AGENT_SOLANA_SAGE=
ELEVENLABS_AGENT_CODE_REVIEWER=
ELEVENLABS_AGENT_GENERAL_HELPER=
ELEVENLABS_AGENT_TOUR_MASTER=

# Override voice IDs per agent (optional — defaults are set in lib/agent-registry.ts)
# ELEVENLABS_VOICE_SOLANA_SAGE=TxGEqnHWrfWFTfGW9XjX
# ELEVENLABS_VOICE_CODE_REVIEWER=ErXwobaYiN019PkySvjV
# ELEVENLABS_VOICE_GENERAL_HELPER=pNInz6obpgDQGcFmaJgB
# ELEVENLABS_VOICE_TOUR_MASTER=21m00Tcm4TlvDq8ikWAM

# ===============================================
# ERC-8004 Agent tokenIds (set after on-chain registration)
# Deploy contracts, call registerAgent() for each agent, then paste the tokenIds here.
# ===============================================
ERC8004_TOKEN_SOLANA_SAGE=
ERC8004_TOKEN_CODE_REVIEWER=
ERC8004_TOKEN_GENERAL_HELPER=
ERC8004_TOKEN_TOUR_MASTER=

# ===============================================
# Platform Configuration
# ===============================================
# The VOISSS platform address that acts as the ERC-8004 delegate.
# Users grant permissions TO this address.
NEXT_PUBLIC_PLATFORM_ADDRESS=0x54351049081A5A64Ea93c56b666830ED5076b960

# Superfluid facilitator (for ACL streaming delegation)
NEXT_PUBLIC_FACILITATOR_ADDRESS=0xYourSuperfluidFacilitatorAddress

# ===============================================
# WDK (Tether Wallet Development Kit) Integration
# Docs: https://docs.wallet.tether.io
# ===============================================
WDK_ENABLED=true
# BIP-39 seed phrase for platform/agent wallets
WDK_SEED_PHRASE=your_bip39_seed_phrase_here
# Active chain: celo | plasma | stable
WDK_ACTIVE_CHAIN=celo
# Facilitator seed phrase for x402 payment settlement (pays gas)
WDK_FACILITATOR_SEED_PHRASE=your_facilitator_seed_phrase_here

# ===============================================
# Firecrawl (OPTIONAL - for advanced web scraping)
# Get your API key from: https://firecrawl.dev
# ==============================================
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ==============================================
# Tavily (OPTIONAL - for AI-powered search)
# Get your API key from: https://tavily.com
# ===============================================
TAVILY_API_KEY=your_tavily_api_key_here
