# Voice Agent Hotline - Environment Variables
# Copy this file to .env.local and fill in your values

# ===============================================
# Thirdweb Configuration (REQUIRED for x402 payments)
# Get your keys from: https://thirdweb.com/dashboard
# ===============================================
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=b9a142d988a6e40baa7342b423bf2361
THIRDWEB_SECRET_KEY=your_secret_key_for_x402

# ============================================
# Celo Network (REQUIRED for production)
# ===============================================
CELO_RPC_URL=https://forno.celo.org
NEXT_PUBLIC_CELO_CHAIN_ID=42220

# Payment receiver wallet (where payments go)
# Get testnet cUSD from: https://faucet.celo.org/
PAYMENT_RECEIVER=0xYourWalletAddressHere

# ===============================================
# WalletConnect (REQUIRED for wallet connection)
# Get your Project ID from: https://cloud.walletconnect.com
# ============================================
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# ===============================================
# Upstash Redis (REQUIRED for production)
# Get credentials from: https://console.upstash.com
# ⚠️ WARNING: Missing credentials cause build warnings
# ============================================
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
UPSTASH_REDIS_URL=${UPSTASH_REDIS_REST_URL}
UPSTASH_REDIS_TOKEN=${UPSTASH_REDIS_REST_TOKEN}

# ===============================================
# x402 Payment Protocol (REQUIRED for micropayments)
# https://x402.org
# ===============================================
X402_FACILITATOR_URL=https://x402.facilitator.example.com
NEXT_PUBLIC_X402_ENABLED=true

# ===============================================
# ElevenLabs Voice API (REQUIRED for real TTS)
# Get your API key from: https://elevenlabs.io/api
# ===========================================
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_DEFAULT_VOICE=Adam

# ===============================================
# VOISSS Integration (Voice over IP for AI Agents)
# https://voisss.netlify.app
# ===============================================
VOISSS_URL=https://voisss.netlify.app
AGENT_WALLET=0xYourAgentWalletAddress

# ===============================================
# ERC-8004 Agent Registry (REQUIRED for agent delegations)
# Deploy contracts or use deployed addresses on Celo
# ============================================
NEXT_PUBLIC_ERC8004_ENABLED=true
NEXT_PUBLIC_ERC8004_IDENTITY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ERC8004_REPUTATION_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ERC8004_DELEGATION_ADDRESS=0x0000000000000000000000000000000000000000

# =============================================
# Feature Flags (SET TO FALSE FOR PRODUCTION)
# ============================================
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_PAYMENTS_ENABLED=true
NEXT_PUBLIC_RECORDING_ENABLED=true

# ==============================================
# ElevenLabs Conversational AI (REQUIRED for voice agents)
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
# ==============================================
ELEVENLABS_CONVERSATIONAL_ENABLED=true

# ===============================================
# Composio Tool Integration (REQUIRED for agent tools)
# Get your API key from: https://composio.dev
# ==============================================
COMPOSIO_API_KEY=your_composio_api_key_here

# Webhook URL for tool callbacks (set to your production domain)
NEXT_PUBLIC_WEBHOOK_URL=https://your-app.vercel.app

# ===============================================
# Firecrawl (OPTIONAL - for advanced web scraping)
# Get your API key from: https://firecrawl.dev
# ==============================================
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ==============================================
# Tavily (OPTIONAL - for AI-powered search)
# Get your API key from: https://tavily.com
# ===============================================
TAVILY_API_KEY=your_tavily_api_key_here
