# Voice Agent Hotline - Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================
# Celo Network
# =============================================
# RPC URL for Celo mainnet
CELO_RPC_URL=https://forno.celo.org

# Payment receiver wallet (where payments go)
PAYMENT_RECEIVER=0x0000000000000000000000000000000000000000

# =============================================
# x402 Payment Facilitator
# =============================================
X402_FACILITATOR_URL=https://x402.facilitator.example.com

# =============================================
# ElevenLabs Voice API
# Get your API key from: https://elevenlabs.io/api
# =============================================
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Default voice (options: Rachel, Domi, Bella, Antoni, Josh, Adam)
ELEVENLABS_DEFAULT_VOICE=Adam

# =============================================
# VOISSS Integration (Voice over IP for AI Agents)
# https://voisss.netlify.app
# =============================================
VOISSS_URL=https://voisss.netlify.app

# Agent wallet for VOISSS payments
AGENT_WALLET=0x0000000000000000000000000000000000000000

# =============================================
# ERC-8004 Agent Registry
# Contract addresses on Celo mainnet
# =============================================
ERC8004_IDENTITY_ADDRESS=0x0000000000000000000000000000000000000000
ERC8004_REPUTATION_ADDRESS=0x0000000000000000000000000000000000000000

# =============================================
# Database (for production)
# =============================================
# DATABASE_URL=postgresql://user:password@localhost:5432/voice_hotline

# =============================================
# Authentication (optional)
# =============================================
# NEXT_AUTH_SECRET=your_nextauth_secret
# NEXT_AUTH_URL=https://your-domain.com

# =============================================
# Feature Flags
# =============================================
# Enable real payments (disable for testing)
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# Enable voice recording
NEXT_PUBLIC_RECORDING_ENABLED=false

# Demo mode (uses mock data)
NEXT_PUBLIC_DEMO_MODE=true
