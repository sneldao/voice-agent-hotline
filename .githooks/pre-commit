#!/usr/bin/env bash
# ============================================
# Pre-commit hook: Secret Detection
# ============================================
# Prevents committing files that contain likely secrets.
# Install: git config core.hooksPath .githooks
# Bypass:  git commit --no-verify

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Files to always skip
SKIP_PATTERNS=(
  ".env.local.example"
  ".env.backend.example"
  ".env.hetzner.example"
  "package-lock.json"
  "pnpm-lock.yaml"
  ".githooks/"
  "contracts-deploy/"
  "tsconfig.tsbuildinfo"
)

# ─────────────────────────────────────────────
# Secret patterns (regex)
# ─────────────────────────────────────────────
PATTERNS=(
  # Ethereum/Celo private keys
  '0x[0-9a-fA-F]{64}'
  # ElevenLabs API keys
  'sk_[a-zA-Z0-9]{20,}'
  # Composio API keys
  'ak_[a-zA-Z0-9]{20,}'
  # Tavily API keys
  'tvly-[a-zA-Z0-9-]{20,}'
  # Upstash Redis tokens (base64-like, long)
  'Aec0[A-Za-z0-9+/=]{40,}'
  # Generic base64-like secrets (must contain + or / to distinguish from hex)
  '[A-Za-z0-9+/]{20,}[/+][A-Za-z0-9+/]{19,}={0,2}'
  # Stripe keys
  'sk_live_[a-zA-Z0-9]{24,}'
  'sk_test_[a-zA-Z0-9]{24,}'
  # AWS keys
  'AKIA[0-9A-Z]{16}'
  # GitHub tokens
  'gh[pousr]_[A-Za-z0-9_]{36,}'
  # Generic SECRET/PASSWORD/TOKEN assignments — must NOT start with < or ${
  '(SECRET|PASSWORD|TOKEN|PRIVATE_KEY|API_KEY)=(?!<|\$\{)[^\s]{20,}'
)

should_skip_file() {
  local file="$1"
  # Skip Solidity files (import paths trigger false positives)
  if [[ "$file" == *.sol ]]; then
    return 0
  fi
  for pattern in "${SKIP_PATTERNS[@]}"; do
    if [[ "$file" == *"$pattern"* ]]; then
      return 0
    fi
  done
  return 1
}

# Get staged files (only added/modified, skip deleted)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

FOUND_SECRETS=0

for file in $STAGED_FILES; do
  # Skip known-safe files
  if should_skip_file "$file"; then
    continue
  fi

  # Skip binary files
  if [[ "$file" =~ \.(png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|mp3|mp4|wav)$ ]]; then
    continue
  fi

  # Get the staged content (not the working tree version)
  CONTENT=$(git show ":$file" 2>/dev/null || true)

  if [ -z "$CONTENT" ]; then
    continue
  fi

  for pattern in "${PATTERNS[@]}"; do
    MATCHES=$(echo "$CONTENT" | grep -nE "$pattern" 2>/dev/null || true)
    if [ -n "$MATCHES" ]; then
      echo -e "${RED}⚠  POSSIBLE SECRET DETECTED${NC} in ${YELLOW}${file}${NC}"
      echo -e "   Pattern: ${pattern}"
      echo "$MATCHES" | while IFS= read -r line; do
        # Truncate long lines to avoid leaking secrets in terminal
        TRUNCATED=$(echo "$line" | cut -c1-120)
        echo -e "   ${TRUNCATED}"
      done
      echo ""
      FOUND_SECRETS=1
    fi
  done
done

if [ "$FOUND_SECRETS" -eq 1 ]; then
  echo -e "${RED}════════════════════════════════════════════════════════${NC}"
  echo -e "${RED}  COMMIT BLOCKED: Possible secrets detected in staged files.${NC}"
  echo -e "${RED}════════════════════════════════════════════════════════${NC}"
  echo ""
  echo "Options:"
  echo "  1. Remove the secrets and stage the fix"
  echo "  2. Add the file to SKIP_PATTERNS in .githooks/pre-commit if this is a false positive"
  echo "  3. Bypass with: git commit --no-verify"
  echo ""
  exit 1
fi

exit 0
