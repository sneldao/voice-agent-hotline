[Unit]
Description=Claflin Broker Desk - Arbitrum
Documentation=https://github.com/sneldao/claflin
After=network.target redis.service
Wants=redis.service

[Service]
Type=forking
User=www-data
Group=www-data

# Working directory
WorkingDirectory=/opt/claflin

# Environment
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0

# Start with PM2
ExecStart=/usr/bin/pm2 start ecosystem.config.js
ExecReload=/usr/bin/pm2 reload claflin
ExecStop=/usr/bin/pm2 stop claflin

# Restart policy
Restart=always
RestartSec=10

# Resource limits (PERFORMANT)
LimitNOFILE=65535
LimitNPROC=65535

# Security hardening (CLEAN)
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=claflin

[Install]
WantedBy=multi-user.target
