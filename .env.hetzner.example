# ================================================
# Voice Agent Hotline - Hetzner VPS Configuration
# ================================================
# Copy this file to .env.hetzner and fill in your values
# cp .env.hetzner.example .env.hetzner
#
# For use with Hetzner VPS or any self-hosted deployment
# ================================================

# ================================================
# Server Configuration (Hetzner-specific)
# ================================================
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# ================================================
# Celo Network Configuration
# ================================================
CELO_RPC_URL=https://forno.celo.org
NEXT_PUBLIC_CELO_CHAIN_ID=42220

# Payment receiver wallet (where payments go)
PAYMENT_RECEIVER=0xYourWalletAddressHere

# ================================================
# Thirdweb Configuration (x402 payments)
# ================================================
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your_thirdweb_client_id
THIRDWEB_SECRET_KEY=your_thirdweb_secret_key

# ================================================
# WalletConnect Configuration
# ================================================
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# ================================================
# Redis Configuration
# ================================================
# Option 1: Local Redis on Hetzner (recommended for performance)
REDIS_URL=redis://localhost:6379

# Option 2: Upstash Redis (managed, use if you prefer)
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ================================================
# ElevenLabs Voice API
# ================================================
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_DEFAULT_VOICE=Adam
ELEVENLABS_CONVERSATIONAL_ENABLED=true

# ElevenLabs Agent IDs (after seeding)
ELEVENLABS_AGENT_SOLANA_SAGE=
ELEVENLABS_AGENT_CODE_REVIEWER=
ELEVENLABS_AGENT_GENERAL_HELPER=
ELEVENLABS_AGENT_TOUR_MASTER=

# Voice overrides per agent (optional)
# ELEVENLABS_VOICE_SOLANA_SAGE=TxGEqnHWrfWFTfGW9XjX
# ELEVENLABS_VOICE_CODE_REVIEWER=ErXwobaYiN019PkySvjV
# ELEVENLABS_VOICE_GENERAL_HELPER=pNInz6obpgDQGcFmaJgB
# ELEVENLABS_VOICE_TOUR_MASTER=21m00Tcm4TlvDq8ikWAM

# ================================================
# Payment Settlement
# ================================================
# Private key of the facilitator wallet that settles payments
FACILITATOR_PRIVATE_KEY=0xYourPrivateKeyHere
NEXT_PUBLIC_PAYMENT_SETTLEMENT_ENABLED=true

# Platform/Agent wallet for ERC-8004 delegation
AGENT_WALLET=0xYourAgentWalletAddress
NEXT_PUBLIC_PLATFORM_ADDRESS=0xYourPlatformWalletAddress

# Superfluid facilitator (for streaming payments)
NEXT_PUBLIC_FACILITATOR_ADDRESS=0xYourSuperfluidFacilitatorAddress

# ================================================
# ERC-8004 Agent Registry
# ================================================
NEXT_PUBLIC_ERC8004_ENABLED=true
NEXT_PUBLIC_ERC8004_IDENTITY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ERC8004_REPUTATION_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ERC8004_DELEGATION_ADDRESS=0x0000000000000000000000000000000000000000

# ERC-8004 Agent tokenIds (after on-chain registration)
ERC8004_TOKEN_SOLANA_SAGE=
ERC8004_TOKEN_CODE_REVIEWER=
ERC8004_TOKEN_GENERAL_HELPER=
ERC8004_TOKEN_TOUR_MASTER=

# ================================================
# Composio Tool Integration
# ================================================
COMPOSIO_API_KEY=your_composio_api_key_here

# Webhook URL (your Hetzner server domain/IP)
NEXT_PUBLIC_WEBHOOK_URL=https://your-domain.com

# ================================================
# Feature Flags
# ================================================
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_PAYMENTS_ENABLED=true
NEXT_PUBLIC_RECORDING_ENABLED=true
NEXT_PUBLIC_X402_ENABLED=true

# ================================================
# Optional Services
# ================================================
# Firecrawl (web scraping)
# FIRECRAWL_API_KEY=your_firecrawl_api_key

# Tavily (AI search)
# TAVILY_API_KEY=your_tavily_api_key

# ================================================
# Dispute Resolution (Optional)
# ================================================
# ARBITRATOR_PRIVATE_KEY=0xYourArbitratorKey
# ARBITRATOR_API_KEY=your_arbitrator_api_key
